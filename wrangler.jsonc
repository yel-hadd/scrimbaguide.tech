{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Static site plus one Worker script: worker/index.ts serves /llm-context.txt
  // (publisher notes for allowlisted AI crawlers, 404 for everyone else) and
  // negotiates markdown twins on `Accept: text/markdown` for HTML routes.
  // run_worker_first lists only /llm-context.txt and the HTML route families:
  // CSS, JS, fonts, images and the .md twins themselves bypass the Worker and
  // are served straight from the edge cache, as before.
  // build/_redirects comes from scripts/cloudflare/build-redirects.mjs (run by `npm run build`);
  // build/_headers is copied from static/_headers.
  "name": "scrimbaguide",
  "compatibility_date": "2026-10-07",
  "main": "worker/index.ts",
  "assets": {
    "directory": "./build",
    "binding": "ASSETS",
    "run_worker_first": [
      "/llm-context.txt",
      "/",
      "/index.html",
      "/about",
      "/blog",
      "/blog/*",
      "/contact",
      "/docs",
      "/docs/*",
      "/downloads",
      "/downloads/*",
      "/legal",
      "/legal/*",
      "/roadmaps",
      "/roadmaps/*",
      "/search",
      "/search/*",
      "/tools",
      "/tools/*",
    ],
    // Folder index files are served at /route/; matches trailingSlash: true.
    "html_handling": "auto-trailing-slash",
    // Serve build/404.html with a real 404 status.
    "not_found_handling": "404-page"
  },
  // A zone route on the proxied apex: switching hosts needs no DNS change, and
  // deleting the route falls straight back to the GitHub Pages origin.
  // www is redirected to the apex by a Cloudflare Redirect Rule, not served here.
  "routes": [{ "pattern": "scrimbaguide.tech/*", "zone_name": "scrimbaguide.tech" }],
  // No second public copy of the site on *.workers.dev or preview URLs.
  "workers_dev": false,
  "preview_urls": false
}
