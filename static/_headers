# Cloudflare Workers static assets headers. Everything not listed keeps the
# platform default (public, max-age=0, must-revalidate, with an ETag).

# Docusaurus content-hashes everything under /assets/.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=2592000

/img/*
  Cache-Control: public, max-age=86400

# Feeds are for readers, not search results.
/blog/rss.xml
  X-Robots-Tag: noindex

/blog/atom.xml
  X-Robots-Tag: noindex

# Markdown twins (page path + .md) are machine-facing alternates of the HTML
# canonical pages; the Worker adds the same tag when serving them via
# Accept: text/markdown negotiation.
/*.md
  X-Robots-Tag: noindex, nofollow
