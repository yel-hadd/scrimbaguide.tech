{
  "name": "scrimbaguide",
  "version": "1.0.0",
  "private": true,
  "description": "The unofficial guide to Scrimba — courses, paths, pricing, and comparisons",
  "scripts": {
    "start": "docusaurus start",
    "build": "docusaurus build && npm run generate:llms && npm run generate:redirects",
    "generate:redirects": "node scripts/cloudflare/build-redirects.mjs",
    "test:redirects": "node --test scripts/__tests__/build-redirects.test.mjs",
    "serve": "docusaurus serve",
    "clear": "docusaurus clear",
    "typecheck": "tsc",
    "generate:data": "node scripts/build-data.mjs",
    "generate:social-cards": "node scripts/generate-social-cards.mjs",
    "generate:llms": "node scripts/generate-llms-from-sitemap.mjs",
    "test:llms": "node --test scripts/__tests__/generate-llms-from-sitemap.test.mjs",
    "test:search": "node --test scripts/__tests__/search-modal.test.mjs",
    "test:a11y": "node --test scripts/__tests__/*a11y*.test.mjs",
    "lhci": "lhci autorun",
    "test:catalog": "node --test scripts/__tests__/derive-catalog.test.mjs",
    "test:visual": "node --test scripts/__tests__/visual-ratchet.test.mjs && node scripts/visual/matrix.mjs; m=$?; node scripts/visual/interactions.mjs; i=$?; [ $m -eq 0 ] && [ $i -eq 0 ]",
    "generate": "npm run generate:data && npm run generate:social-cards",
    "assert-sitemap-url": "node scripts/assert-sitemap-url.mjs",
    "submit-indexnow": "node scripts/submit-indexnow.mjs",
    "swizzle": "docusaurus swizzle",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids",
    "check:content": "node scripts/check-content.mjs",
    "prebuild": "npm run check:content && npm run check:schema",
    "check:schema": "node scripts/check-schema-visible.mjs",
    "check:metadata": "node scripts/check-built-metadata.mjs",
    "snapshot": "python3 scripts/analytics/snapshot.py",
    "test:analytics": "python3 -m unittest discover -s scripts/analytics/tests -t scripts/analytics && node --test scripts/__tests__/analytics.test.mjs"
  },
  "dependencies": {
    "@docusaurus/core": "3.9.2",
    "@docusaurus/plugin-client-redirects": "3.9.2",
    "@docusaurus/preset-classic": "3.9.2",
    "@easyops-cn/docusaurus-search-local": "^0.53.0",
    "@mdx-js/react": "^3.0.0",
    "clsx": "^2.0.0",
    "lucide-react": "^1.18.0",
    "prism-react-renderer": "^2.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "web-vitals": "6.2.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@docusaurus/module-type-aliases": "3.9.2",
    "@docusaurus/tsconfig": "3.9.2",
    "@docusaurus/types": "3.9.2",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "^1.58.2",
    "axe-core": "^4.11.1",
    "typescript": "~5.6.2"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": ">=20.0"
  },
  "overrides": {
    "serialize-javascript": "7.1.2",
    "tmp": "0.2.7",
    "uuid": "11.1.1"
  }
}
